# Backend local. ./scripts/dev.sh crée et partage automatiquement la clé locale.
APP_ENV=development
DEBUG=false
WORKSPACE_DB_PATH=backend/lexia.db
WORKSPACE_API_KEY=
SECRET_KEY=
ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# L'envoi automatique n'est pas implémenté dans cette version.
# Même true ne rend pas les transports incomplets utilisables.
COMMERCIAL_LAUNCH_ENABLED=false

# Production : volume persistant obligatoire à /data.
# APP_ENV=production
# DEBUG=false
# WORKSPACE_DB_PATH=/data/workspace.db
# WORKSPACE_API_KEY=<secret aléatoire >=32 caractères partagé avec le frontend>
# SECRET_KEY=<autre secret aléatoire >=32 caractères>
# ALLOWED_HOSTS=["votre-api.up.railway.app","healthcheck.railway.app"]
# ALLOWED_ORIGINS=["https://votre-frontend.vercel.app"]

# Prototype IA/transport : non nécessaires au workspace, laisser vides.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
ANTHROPIC_API_KEY=
SMARTLEAD_API_KEY=
APOLLO_API_KEY=
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=
REDIS_URL=redis://localhost:6379/0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SENTRY_DSN=
