# Backend local. ./scripts/dev.sh crée et partage automatiquement la clé locale.
APP_ENV=development
DEBUG=false
WORKSPACE_DB_PATH=backend/lexia.db
# Vide en local. En production gratuite : rôle PostgreSQL restreint outreached_app.
WORKSPACE_DATABASE_URL=
# Optionnel : chemin du certificat CA ; sinon magasin système.
WORKSPACE_DATABASE_SSL_ROOT_CERT=
WORKSPACE_API_KEY=
SECRET_KEY=
ALLOWED_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# L'envoi automatique n'est pas implémenté dans cette version.
# Même true ne rend pas les transports incomplets utilisables.
COMMERCIAL_LAUNCH_ENABLED=false

# Production gratuite : PostgreSQL externe, jamais SQLite sur disque éphémère.
# WORKSPACE_DATABASE_URL=postgresql://outreached_app:PASSWORD@HOST/neondb?sslmode=verify-full
# APP_ENV=production
# DEBUG=false
# WORKSPACE_API_KEY=<secret aléatoire >=32 caractères partagé avec le frontend>
# SECRET_KEY=<autre secret aléatoire >=32 caractères>
# ALLOWED_HOSTS=["votre-service.onrender.com"]
# ALLOWED_ORIGINS=["https://votre-service.onrender.com"]
# Le lanceur combiné déduit hôtes/origines de WORKSPACE_PUBLIC_ORIGIN.
# Pour le Dockerfile SQLite historique uniquement : volume persistant /data obligatoire.

# Prototype IA/transport : non nécessaires au workspace, laisser vides.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
ANTHROPIC_API_KEY=
SMARTLEAD_API_KEY=
APOLLO_API_KEY=
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=
REDIS_URL=redis://localhost:6379/0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SENTRY_DSN=
