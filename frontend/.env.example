# Server-side only. None of these are exposed to the browser.
# postgres : accès direct à la base depuis Next.js (Netlify).
# proxy : backend Python existant, valeur par défaut.
WORKSPACE_BACKEND=proxy
# Requis seulement en mode postgres. Utiliser le rôle limité outreached_app,
# jamais le propriétaire de la base. Connexion TLS avec sslmode=verify-full.
WORKSPACE_DATABASE_URL=

# Les variables BACKEND_* et WORKSPACE_API_KEY concernent seulement le mode proxy.
BACKEND_URL=http://127.0.0.1:8001
# true uniquement dans le conteneur combiné : URL loopback exacte ci-dessus.
# Un backend externe exige HTTPS en production.
BACKEND_INTERNAL=false

# The workspace secret used to authenticate against the Outreached API.
# It is injected by the Next.js server route (app/api/[...path]/route.ts)
# and is never sent to, stored by, or readable from the browser.
WORKSPACE_API_KEY=

# Public origin of the deployed frontend (used to restrict proxied requests).
# Example: WORKSPACE_PUBLIC_ORIGIN=https://prospection.example.com
WORKSPACE_PUBLIC_ORIGIN=http://localhost:3000

# Generated with: node scripts/setup-auth.mjs --output ../.runtime/auth
# Mode PostgreSQL : ajouter --postgres --origin https://VOTRE-SITE.netlify.app
# Le script génère les identifiants de connexion ; ajouter séparément l'URL de la base.
# Use exact HTTPS origins in production. These credentials are server-only.
WORKSPACE_LOGIN_USER=
WORKSPACE_PASSWORD_HASH=
WORKSPACE_SESSION_SECRET=
