# Server-side only. None of these are exposed to the browser.
BACKEND_URL=http://127.0.0.1:8001

# The workspace secret used to authenticate against the Outreached API.
# It is injected by the Next.js server route (app/api/[...path]/route.ts)
# and is never sent to, stored by, or readable from the browser.
WORKSPACE_API_KEY=

# Public origin of the deployed frontend (used to restrict proxied requests).
# Example: WORKSPACE_PUBLIC_ORIGIN=https://prospection.example.com
WORKSPACE_PUBLIC_ORIGIN=http://localhost:3000

# Generated with: node scripts/setup-auth.mjs --output ../.runtime/auth
# Use exact HTTPS origins in production. These credentials are server-only.
WORKSPACE_LOGIN_USER=
WORKSPACE_PASSWORD_HASH=
WORKSPACE_SESSION_SECRET=
