# One public web process and a private loopback API; all business data lives in
# externally managed PostgreSQL. No application secrets are passed at build time.
FROM node:22.23.1-bookworm-slim AS frontend-build
WORKDIR /web
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm install --global pnpm@10.33.0
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
RUN pnpm build

FROM ghcr.io/astral-sh/uv:0.11.3 AS uv
FROM python:3.12-slim-bookworm AS python-build
WORKDIR /app
ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
COPY --from=uv /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/ ./backend/
RUN uv sync --frozen --no-dev

FROM python:3.12-slim-bookworm AS runtime
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    APP_ENV=production NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 \
    NODE_OPTIONS=--max-old-space-size=192 \
    BACKEND_INTERNAL=true BACKEND_URL=http://127.0.0.1:8001 PORT=10000
RUN apt-get update && apt-get install --no-install-recommends -y libstdc++6 && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 10001 outreached && \
    useradd --uid 10001 --gid 10001 --no-create-home outreached
COPY --from=frontend-build /usr/local/bin/node /usr/local/bin/node
COPY --from=python-build /app/.venv /app/.venv
COPY --from=python-build /app/backend /app/backend
COPY --from=frontend-build --chown=10001:10001 /web/.next/standalone ./frontend/
COPY --from=frontend-build --chown=10001:10001 /web/.next/static ./frontend/.next/static/
COPY --from=frontend-build --chown=10001:10001 /web/public ./frontend/public/
COPY scripts/serve_free.py scripts/workspace_postgres.py scripts/workspace_backup.py ./scripts/
COPY migrations/004_workspace.sql ./migrations/004_workspace.sql
USER 10001:10001
EXPOSE 10000
CMD ["python", "scripts/serve_free.py"]
